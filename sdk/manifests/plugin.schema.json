{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmcache.dev/schemas/plugin-v1alpha1.json",
  "title": "LLM Cache plugin manifest (llmcache.dev/v1alpha1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "llmcache.dev/v1alpha1"},
    "kind": {"const": "Plugin"},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
        "version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)([-+].+)?$"},
        "description": {"type": "string", "maxLength": 500}
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"enum": ["llm", "embedder", "vector-store", "persistence", "queue", "policy", "embedding-model", "vector-index", "similarity-metric"]},
        "contract": {"type": "object", "additionalProperties": false, "properties": {"version": {"const": "v1"}}},
        "runtime": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["container", "python", "endpoint"]},
            "dockerfile": {"type": "string"}, "context": {"type": "string"},
            "port": {"type": "integer", "minimum": 1024, "maximum": 65535}
          }
        },
        "python": {
          "type": "object", "additionalProperties": false, "required": ["module", "backend"],
          "properties": {
            "module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"},
            "path": {"type": "string"},
            "backend": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
            "requirements": {"type": "string"}
          }
        },
        "health": {
          "type": "object", "additionalProperties": false,
          "properties": {"path": {"type": "string", "pattern": "^/"}, "timeout": {"type": "string"}}
        },
        "config": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": {
                "type": "object", "additionalProperties": false, "required": ["type"],
                "properties": {
                  "type": {"enum": ["string", "integer", "number", "boolean", "duration", "enum"]},
                  "required": {"type": "boolean"}, "default": {}, "description": {"type": "string"},
                  "enum": {"type": "array", "items": {"type": "string"}},
                  "min": {"type": "number"}, "max": {"type": "number"}
                }
              }
            }
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
              "required": {"type": "boolean"}, "description": {"type": "string"}
            }
          }
        },
        "resources": {
          "type": "object", "additionalProperties": false,
          "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}, "pids": {"type": "integer", "maximum": 1024}, "tmpfs": {"type": "string"}}
        },
        "network": {"type": "object", "additionalProperties": false, "properties": {"egress": {"enum": ["none", "internet"]}}},
        "verify": {"type": "object", "additionalProperties": false, "properties": {"vectorDim": {"type": "integer", "minimum": 0, "maximum": 8192}}}
      }
    }
  }
}
