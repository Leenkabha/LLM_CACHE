# Copy to .env and fill in. docker-compose reads this file.

# --- Orchestrator ---
ORCH_ADDR=:8080
SIMILARITY_THRESHOLD=0.25     # max cosine DISTANCE for a hit (lower = stricter)
CACHE_CAPACITY=1000
CACHE_POLICY=lru              # lru | lfu

# --- Downstream service URLs (used by the orchestrator) ---
EMBEDDING_URL=http://embedding:8001
VECTORSTORE_URL=http://vectorstore:8002
REDIS_ADDR=redis:6379

# --- LLM backend ---
# stub  -> returns a canned reply (no network, good for the skeleton)
# openai -> calls the OpenAI API (set OPENAI_API_KEY)
LLM_MODE=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
