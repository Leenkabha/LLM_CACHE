# Copy to .env and fill in. docker-compose reads this file.

# --- Orchestrator ---
ORCH_ADDR=:8080
SIMILARITY_THRESHOLD=0.25     # max cosine DISTANCE for a hit (lower = stricter)
CACHE_TOP_K=1                # max accepted cached replies, must be >= 1
CACHE_CAPACITY=1000
CACHE_POLICY=lru              # lru | lfu | fifo
LOG_FILE=logs/orchestrator.log # persistent orchestrator log file

# --- Downstream service URLs (used by the orchestrator) ---
EMBEDDING_URL=http://embedding:8001
VECTORSTORE_URL=http://vectorstore:8002
REDIS_ADDR=redis:6379

# --- Pluggable backends (each maps to a factory in its package) ---
# Every seam below is an interface with a factory that picks an implementation
# by name. Defaults reproduce the demo stack; a typo fails fast at startup.
EMBEDDING_BACKEND=http        # orchestrator's embedder adapter: http
VECTORSTORE_BACKEND=http      # orchestrator's vector-store adapter: http
PERSISTENCE_BACKEND=redis     # cache-entry storage: redis | memory
QUEUE_BACKEND=redis           # async cache-update queue: redis

# --- Embedding service (Python) internals ---
# EMBEDDING_BACKEND above selects the ORCHESTRATOR's client adapter; these two
# select the model INSIDE the embedding service container.
EMBEDDING_MODEL_BACKEND=sentence-transformers  # embedding model family
EMBEDDING_MODEL=all-MiniLM-L6-v2               # concrete model name

# --- Vector store service (Python) internals ---
VECTOR_INDEX_BACKEND=faiss    # vector index engine inside the service: faiss
SIMILARITY_METRIC=cosine      # cosine | euclidean (must suit the embedding model)
VECTOR_DIM=384                # must equal the embedding model's output size

# --- LLM backend ---
# stub   -> returns a canned reply (no network, good for the skeleton)
# openai -> calls the OpenAI API (set OPENAI_API_KEY)
# gemini -> calls the Google Gemini API, free tier (set GEMINI_API_KEY)
LLM_MODE=stub
# Optional: if LLM_MODE fails (after retrying), fall back to this registered
# backend instead of failing the request. Any registered name works, e.g.
# LLM_FALLBACK_MODE=stub. Leave blank (default) to fail loudly instead.
LLM_FALLBACK_MODE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional: log how much Gemini quota is left after each answer (0 = unknown).
GEMINI_DAILY_REQUEST_LIMIT=0
GEMINI_DAILY_TOKEN_BUDGET=0

# --- Optional custom HTTP LLM example (LLM_MODE=example-http) ---
# Start the local example with: docker compose --profile example-llm up --build -d
EXAMPLE_LLM_URL=http://example-llm:8090/complete
EXAMPLE_LLM_MODEL=demo
EXAMPLE_LLM_TOKEN=
EXAMPLE_LLM_TIMEOUT=30s

# --- Plugin platform (OFF by default; see docs/PLUGIN_PLATFORM.md) ---------------------
# Lets an administrator add LLM / embedder / vector-store / persistence / queue / policy
# plugins (and Python embedding-model / vector-index / similarity-metric plugins) from the
# web UI at /plugins without editing code or config. Management stays disabled unless ALL of
# ENABLE_PLUGIN_INSTALLATION, ADMIN_TOKEN and PLUGIN_SECRET_KEY are set.
ENABLE_PLUGIN_INSTALLATION=false
# Protects the /admin/* plugin API (and /flush, /policy). Generate: openssl rand -hex 24
ADMIN_TOKEN=
# Encrypts plugin secrets at rest (AES-256-GCM). Base64 of 32 random bytes:
#   openssl rand -base64 32
# Losing or changing this key makes stored plugin secrets unreadable.
PLUGIN_SECRET_KEY=
# Development only: allow http, loopback, private addresses and compose service names for
# hosted-endpoint plugins. Leave false in production.
ALLOW_INSECURE_PLUGIN_ENDPOINTS=false
# Image/repository installs need the controller (docker compose --profile plugins up -d).
PLUGIN_CONTROLLER_URL=
# Shared secret between orchestrator and controller, at least 16 characters.
PLUGIN_CONTROLLER_TOKEN=
# Optional limits (defaults: 10m build, 60s health, 1 CPU, 512Mi per plugin).
PLUGIN_BUILD_TIMEOUT=
PLUGIN_HEALTH_TIMEOUT=
PLUGIN_CPU_LIMIT=
PLUGIN_MEMORY_LIMIT=
