# Copy to production.env (gitignored via *.env) and fill in. Never commit real values.
# Used by: docker compose -f docker-compose.prod.yml --env-file production.env up --build -d

# Required: real answers come from Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Required: protects POST /flush and POST /policy. Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# Public address. ":80" serves plain HTTP on the server's IP.
# A domain name (DNS pointing at this server) gives automatic HTTPS.
SITE_ADDRESS=:80

# Max /query requests per visitor IP per minute (protects your Gemini quota).
RATE_LIMIT_PER_MIN=30

# Optional cache tuning
SIMILARITY_THRESHOLD=0.25
CACHE_CAPACITY=1000
CACHE_POLICY=lru
