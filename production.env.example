# Copy to production.env (gitignored via *.env) and fill in. Never commit real values.
# Used by: docker compose -f docker-compose.prod.yml --env-file production.env up --build -d

# Required: real answers come from Gemini.
GEMINI_API_KEY=
# Cheapest Gemini model (about $0.25 in / $1.50 out per 1M tokens; 2.5 Flash-Lite is no longer offered to new users). Free tier limits are per model.
GEMINI_MODEL=gemini-3.1-flash-lite

# Required: protects POST /flush and POST /policy. Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# Public address. ":80" serves plain HTTP on the server's IP.
# A domain name (DNS pointing at this server) gives automatic HTTPS.
SITE_ADDRESS=:80

# Optional: log how much Gemini quota is left after every answer. Gemini does not
# report remaining quota, so this counts from the limit you set (0 = unknown).
# Free tier is about 20 requests/day per model; see https://ai.dev/rate-limit.
GEMINI_DAILY_REQUEST_LIMIT=0
GEMINI_DAILY_TOKEN_BUDGET=0

# Max /query requests per visitor IP per minute (protects your Gemini quota).
RATE_LIMIT_PER_MIN=30

# Optional cache tuning
SIMILARITY_THRESHOLD=0.25
CACHE_CAPACITY=1000
CACHE_POLICY=lru

# --- Plugin platform (optional; OFF by default) ---------------------------------------
# See docs/PLUGIN_PLATFORM.md and docs/PLUGIN_SECURITY.md before enabling. It needs
# ADMIN_TOKEN (above) and PLUGIN_SECRET_KEY: openssl rand -base64 32
# Image/repository installs also need a Docker daemon for the controller
# (docker compose ... --profile plugins). That is root-equivalent access to that host.
ENABLE_PLUGIN_INSTALLATION=false
PLUGIN_SECRET_KEY=
PLUGIN_CONTROLLER_URL=
PLUGIN_CONTROLLER_TOKEN=
PLUGIN_BUILD_TIMEOUT=
PLUGIN_HEALTH_TIMEOUT=
PLUGIN_CPU_LIMIT=
PLUGIN_MEMORY_LIMIT=
# Enable image scanning if trivy is available to the controller image; fail closed without it:
PLUGIN_SCANNER=none
PLUGIN_REQUIRE_SCAN=false
